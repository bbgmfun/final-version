# Common
NODE_ENV=development

# ---- Microsoft Entra ID (authentication) ----
# These come from your Entra app registration (az ad app create output).
# The values below are pre-filled for this project's tenant.
ENTRA_TENANT_ID=e7c46463-2529-40d9-b0e5-4b8a4acd39dd
ENTRA_CLIENT_ID=9549924f-8527-4327-8761-57cfde23985b

# App-level authorization. Authentication is done by Entra; the app role is
# derived here. Any signed-in email NOT in this list is a normal "user".
ADMIN_EMAILS=22070006074@stu.yasar.edu.tr
# Hotels an admin is allowed to manage (comma-separated).
ADMIN_HOTEL_IDS=hotel-swiss

# Service ports
API_GATEWAY_PORT=8080
IAM_PORT=4001
HOTEL_PORT=4002
COMMENTS_PORT=4003
NOTIFICATION_PORT=4004
AI_AGENT_PORT=4005

# MongoDB  (use the Azure Cosmos DB Mongo connection string in the cloud)
MONGO_URI=mongodb://mongo:27017/hotelbooking

# Redis
REDIS_URL=redis://redis:6379
HOTEL_CACHE_TTL=300

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:5672
RESERVATION_QUEUE=reservations

# Internal service URLs (used by API Gateway)
IAM_URL=http://iam-service:4001
HOTEL_URL=http://hotel-service:4002
COMMENTS_URL=http://comments-service:4003
NOTIFICATION_URL=http://notification-service:4004
AI_AGENT_URL=http://ai-agent-service:4005

# Notification scheduling
CAPACITY_ALERT_THRESHOLD=0.20
NIGHTLY_CRON="0 2 * * *"
RESERVATION_DRAIN_CRON="*/1 * * * *"

# Discount for logged-in users
LOGIN_DISCOUNT=0.15

# ---- AI Agent LLM (OpenAI-compatible endpoint: Groq / OpenAI / Together...) ----
# Get a FREE key at https://console.groq.com  (free tier, supports tool calling).
# If LLM_API_KEY is left empty the agent falls back to the rule-based parser.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
